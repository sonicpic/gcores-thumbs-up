{
  "name": "gcores-thumbs-up",
  "private": true,
  "version": "0.3.0",
  "description": "GCORES feeds auto-like automation: headless Playwright worker scheduled by Windows Task Scheduler",
  "main": "src/cli.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "gc:run": "node src/cli.js run",
    "gc:ui": "node src/cli.js ui",
    "gc:dry": "node src/cli.js run --dry-run",
    "gc:doctor": "node src/cli.js doctor",
    "test": "node --test test/unit.test.js",
    "gc:session": "node src/cli.js session status",
    "gc:session:import": "node src/cli.js session import",
    "gc:login": "node src/cli.js session login",
    "gc:state": "node src/cli.js state show",
    "gc:state:reset": "node src/cli.js state reset",
    "gc:notify:test": "node src/cli.js notify test",
    "gc:task:install": "node src/cli.js task install",
    "gc:task:remove": "node src/cli.js task remove",
    "gc:task:status": "node src/cli.js task status",
    "gc:task:start": "node src/cli.js task start",
    "gc:task:stop": "node src/cli.js task stop",
    "gc:check": "node --check src/cli.js",
    "gcores:login": "node src/cli.js session login",
    "gcores:run": "node src/cli.js run"
  },
  "dependencies": {
    "playwright": "^1.59.1"
  }
}
